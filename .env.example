# ============================================================
#  MẪU FILE CẤU HÌNH – AI Agent Chat MagentX
#  Cách dùng: chép file này thành ".env" rồi điền giá trị thật.
#  File ".env" KHÔNG được đưa lên GitHub (đã chặn trong .gitignore).
#  Dòng bắt đầu bằng # là ghi chú.
# ============================================================

# --- Chung ---
# development = đang thử trên máy; production = chạy khách thật
NODE_ENV=development
# Cổng web nhận webhook Pancake trên máy (ngrok sẽ trỏ vào cổng này)
PORT=3000
# Mức ghi log: debug | info | warn | error
LOG_LEVEL=info

# --- Webhook Pancake ---
# Mã bí mật dài gắn trên địa chỉ webhook, ví dụ: https://xxx.ngrok.app/webhook/<mã này>
# Ít nhất 24 ký tự chữ và số ngẫu nhiên. Sai mã → bot bỏ qua, ghi nhật ký.
WEBHOOK_SECRET_PATH=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-24-ky-tu

# --- Database PostgreSQL (trên MacBook) ---
# Tài khoản bot_app dùng khi chạy bot (quyền giới hạn)
DATABASE_URL=postgresql://bot_app:MAT_KHAU_BOT_APP@localhost:5432/magentx_test
# Tài khoản chủ, CHỈ dùng để chạy migration (npm run migrate). Với Postgres.app thường là tên người dùng Mac.
DATABASE_ADMIN_URL=postgresql://TEN_NGUOI_DUNG_MAC@localhost:5432/magentx_test

# --- Claude (Anthropic) ---
# Lấy tại console.anthropic.com. Chưa cần ở GĐ5.
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-haiku-5-5
CLAUDE_MODEL_DEEP=claude-sonnet-5-5

# --- Pancake (fanpage thử nghiệm) ---
# Mã trang và Page Access Token của fanpage thử. Token lấy trong Pancake (tôi sẽ chỉ chỗ).
PANCAKE_TEST_PAGE_ID=
PANCAKE_TEST_PAGE_TOKEN=

# --- Telegram ---
# Token bot chính (tạo qua @BotFather). Bot "MagentX Canh" KHÔNG để ở đây, token của nó nằm trong Apps Script.
TELEGRAM_BOT_TOKEN=
# Telegram ID (dãy số) của quản trị. Gửi /start cho bot, bot sẽ trả lại ID này.
TELEGRAM_ADMIN_ID=

# --- Người canh (Google Apps Script) ---
# Địa chỉ web app Apps Script nhận nhịp tim, và mã bí mật trùng với mã đặt trong Apps Script
HEARTBEAT_URL=
HEARTBEAT_SECRET=

# --- Sao lưu ---
# Mật khẩu mã hóa bản sao lưu (ít nhất 12 ký tự). Cất thêm một bản trong trình quản lý mật khẩu.
BACKUP_PASSWORD=
# Đường dẫn file JSON tài khoản dịch vụ Google (để ghi lên Drive) và mã thư mục Drive chứa sao lưu
GOOGLE_SERVICE_ACCOUNT_FILE=
DRIVE_BACKUP_FOLDER_ID=
