{
  "name": "magentx-agent-chat",
  "version": "0.1.0",
  "private": true,
  "description": "Bot AI trực inbox MagentX qua Pancake (Facebook, Instagram)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "vitest run",
    "migrate": "tsx db/migrate.ts",
    "thu": "tsx scripts/thu-nghiem/index.ts",
    "sao-luu": "tsx scripts/sao-luu.ts",
    "khoi-phuc": "tsx scripts/khoi-phuc.ts",
    "db:setup": "tsx db/setup.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vitest": "^5.1.1"
  }
}
